# 推送通道（選一個）。填好後 publish.sh 每次產圖都會自動推送到手機
# CHANNEL=wecom  → 企业微信群机器人（可自己在群裡看；企業微信「微信插件」可把應用消息轉到微信）
# CHANNEL=telegram → 圖片直達手機（最穩，跨平台）
# CHANNEL=bark    → iOS 通知（僅文字標題，圖片需另點連結）
# CHANNEL=none    → 關閉
CHANNEL=none

# 企业微信群机器人：在群设置 → 群机器人 → 添加 → 复制 Webhook 地址
WECOM_WEBHOOK=

# Telegram：找 @BotFather 建 bot 拿 token；chat_id 可先用 @userinfobot 查
TG_TOKEN=
TG_CHAT=

# Bark（iOS App）：App 首頁會給一串 key
BARK_KEY=
